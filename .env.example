# Copy to .env.local and paste the configuration of your Firebase web app.
# These VITE_ values are embedded in the browser build, not server secrets.
# Never put App Check debug tokens or service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
